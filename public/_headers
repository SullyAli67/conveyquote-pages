# Browser caching for static files (Cloudflare Pages applies these to static assets only, never to /api Functions).
# Pages otherwise sends "max-age=0, must-revalidate", so every repeat visit re-checks every file with the server.

# Vite's build output: file names change whenever the content does, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts, hero stills and icons keep their names when replaced, so cache for a day and refresh in the background.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
